# 배포 플랫폼의 Secrets 설정에 아래 값을 넣으십시오.
# (Streamlit Community Cloud: App settings → Secrets 에 그대로 붙여넣기)
# 로컬에서는 프로젝트 루트의 .env 파일을 써도 됩니다 — 둘 다 src/common.load_secrets() 가 읽습니다.
#
# 전부 선택 사항입니다. 없으면 해당 기능만 꺼지고 앱은 정상 동작합니다.
GEMINI_API_KEY = ""          # AI 상담 답변 생성 (없으면 수집된 사실만 정리해 표시)
NAVER_CLIENT_ID = ""         # 검색어트렌드·뉴스·로고 (developers.naver.com, 무료)
NAVER_CLIENT_SECRET = ""
DART_API_KEY = ""            # 가맹본부 재무 재수집 (opendart.fss.or.kr, 무료)
DATA_GO_KR_KEY = ""          # 공정위 공시 재수집
IFRMP_SERVICE_KEY = ""       # 정보공개서 원문 (franchise.ftc.go.kr)
